{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "numerus-api": {
      "root": "numerus-api",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/py/(.*)", "destination": { "service": "numerus-api" } },
    { "source": "/api/pluggy/(.*)", "destination": { "service": "numerus-api" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
