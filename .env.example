# credenciais do Pluggy (https://dashboard.pluggy.ai → Applications)
# copie para .env — o .env não vai para o git
# use as de uma aplicação nova: ela já tem acesso aos conectores sandbox
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# copie para .env e preencha. nunca suba o .env para o github.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDAR_ASSINATURA=false

LIMITE_MSGS_POR_HORA=30
MAX_TOKENS_RESPOSTA=400
MAX_HISTORICO=6
CORS_ORIGENS=*
